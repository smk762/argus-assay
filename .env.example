# Where the browser finds argus-mint (baked in at build time). Default: the mock / a local server.
NEXT_PUBLIC_MINT_URL=http://localhost:8108
# The port assay serves on.
PORT=3108
# `mock` runs the fixture-backed stand-in argus-mint on :8108 (no GPU, darkroom, IPFS or wallet).
COMPOSE_PROFILES=mock
# Comma-separated LAN hosts `next dev` should accept (e.g. 192.168.1.20).
ASSAY_DEV_ORIGINS=
